/* EXPECT: x = 42
Address taken
Value via pointer: 42
Modified via pointer
x = 100
Done */

module exe test_exe_pointers;

var
  x: int32;
  p: pointer to int32;

begin
  x := 42;
  println("x = {}", x);
  
  // Take address of x
  p := address of x;
  println("Address taken");
  
  // Read via pointer
  println("Value via pointer: {}", p^);
  
  // Write via pointer
  p^ := 100;
  println("Modified via pointer");
  println("x = {}", x);
  
  println("Done");
end.