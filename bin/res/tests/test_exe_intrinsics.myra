/* EXPECT: === size(type) ===
size(int8) = 1
size(int16) = 2
size(int32) = 4
size(int64) = 8
size(uint8) = 1
size(uint16) = 2
size(uint32) = 4
size(uint64) = 8
size(float32) = 4
size(float64) = 8
size(boolean) = 1
size(char) = 1
size(wchar) = 2
=== size(expr) ===
size(x) = 4
size(y) = 8
=== paramcount/paramstr ===
paramcount = 0
=== Done === */

module exe test_exe_intrinsics;

var
  x: int32;
  y: float64;
  i: int32;
  n: int32;

begin
  println("=== size(type) ===");
  println("size(int8) = {}", size(int8));
  println("size(int16) = {}", size(int16));
  println("size(int32) = {}", size(int32));
  println("size(int64) = {}", size(int64));
  println("size(uint8) = {}", size(uint8));
  println("size(uint16) = {}", size(uint16));
  println("size(uint32) = {}", size(uint32));
  println("size(uint64) = {}", size(uint64));
  println("size(float32) = {}", size(float32));
  println("size(float64) = {}", size(float64));
  println("size(boolean) = {}", size(boolean));
  println("size(char) = {}", size(char));
  println("size(wchar) = {}", size(wchar));

  println("=== size(expr) ===");
  x := 42;
  y := 3.14;
  println("size(x) = {}", size(x));
  println("size(y) = {}", size(y));

  println("=== paramcount/paramstr ===");
  n := paramcount();
  println("paramcount = {}", n);
  
  /* paramstr(0) = full path to exe, varies by machine so not in EXPECT */
  /* Loop from 1 to n prints user args only */
  i := 1;
  while i <= n do
    println("paramstr({}) = {}", i, paramstr(i));
    i := i + 1;
  end;

  println("=== Done ===");
end.