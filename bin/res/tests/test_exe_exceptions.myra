/* EXPECT: === Basic guard/except ===
Exception caught: code=1, msg=Test error
=== Guard/finally (no exception) ===
In guard block
In finally block
After guard
=== Guard/except/finally ===
In guard block
In except block: code=1
In finally block
=== raisecode ===
Custom code: 42, msg=Custom error
=== Nested guard ===
Inner exception caught
Outer finally
=== Hardware exception (div by zero) ===
Hardware exception caught: code=2, msg=Divide by zero
=== Local variable capture ===
Before: localVar=100
Inside guard: localVar=100
After modify: localVar=200
After guard: localVar=200
=== Parameter capture ===
Param in guard: value=42
=== Global variable in guard ===
Global in guard: gValue=999
=== Routine with guard modifying local ===
Result: 30
=== Multiple sequential guard blocks ===
First guard ok
Second guard ok
localA=10, localB=20
=== Exception propagation ===
Caught propagated: code=1
Done */

module exe test_exe_exceptions;

var
  gValue: int32;

// Helper routine to return zero at runtime (prevents LLVM optimization)
routine getZero(): int32;
begin
  return 0;
end;

// Test local variable capture in routine
routine testLocalCapture();
var
  localVar: int32;
begin
  localVar := 100;
  println("Before: localVar={}", localVar);
  guard
    println("Inside guard: localVar={}", localVar);
    localVar := 200;
    println("After modify: localVar={}", localVar);
  except
    println("Should not reach");
  end;
  println("After guard: localVar={}", localVar);
end;

// Test parameter capture
routine testParamCapture(const AValue: int32);
begin
  guard
    println("Param in guard: value={}", AValue);
  except
    println("Should not reach");
  end;
end;

// Test routine with guard that modifies and returns
routine computeWithGuard(const A: int32; const B: int32): int32;
var
  result: int32;
begin
  result := 0;
  guard
    result := A + B;
  except
    result := -1;
  end;
  return result;
end;

// Routine that throws - for propagation test
routine throwingRoutine();
begin
  raise("Propagated error");
end;

// Test exception propagation
routine testPropagation();
begin
  guard
    throwingRoutine();
  except
    println("Caught propagated: code={}", exccode());
  end;
end;

var
  x: int32;
  localA: int32;
  localB: int32;

begin
  // Test 1: Basic guard/except with raise - test excmsg
  println("=== Basic guard/except ===");
  guard
    raise("Test error");
    println("Should not print");
  except
    println("Exception caught: code={}, msg={}", exccode(), excmsg());
  end;

  // Test 2: Guard/finally without exception
  println("=== Guard/finally (no exception) ===");
  guard
    println("In guard block");
  finally
    println("In finally block");
  end;
  println("After guard");

  // Test 3: Guard/except/finally
  println("=== Guard/except/finally ===");
  guard
    println("In guard block");
    raise("Error!");
  except
    println("In except block: code={}", exccode());
  finally
    println("In finally block");
  end;

  // Test 4: raisecode with custom code and message
  println("=== raisecode ===");
  guard
    raisecode(42, "Custom error");
  except
    println("Custom code: {}, msg={}", exccode(), excmsg());
  end;

  // Test 5: Nested guard blocks
  println("=== Nested guard ===");
  guard
    guard
      raise("Inner error");
    except
      println("Inner exception caught");
    end;
  finally
    println("Outer finally");
  end;

  // Test 6: Hardware exception (division by zero) - test message
  println("=== Hardware exception (div by zero) ===");
  guard
    x := 10 div getZero();
    println("Should not print: {}", x);
  except
    println("Hardware exception caught: code={}, msg={}", exccode(), excmsg());
  end;

  // Test 7: Local variable capture in routine
  println("=== Local variable capture ===");
  testLocalCapture();

  // Test 8: Parameter capture
  println("=== Parameter capture ===");
  testParamCapture(42);

  // Test 9: Global variable access in guard (main block)
  println("=== Global variable in guard ===");
  gValue := 999;
  guard
    println("Global in guard: gValue={}", gValue);
  except
    println("Should not reach");
  end;

  // Test 10: Routine with guard that computes result
  println("=== Routine with guard modifying local ===");
  x := computeWithGuard(10, 20);
  println("Result: {}", x);

  // Test 11: Multiple sequential guard blocks sharing locals
  println("=== Multiple sequential guard blocks ===");
  localA := 0;
  localB := 0;
  guard
    localA := 10;
    println("First guard ok");
  except
    println("Should not reach");
  end;
  guard
    localB := 20;
    println("Second guard ok");
  except
    println("Should not reach");
  end;
  println("localA={}, localB={}", localA, localB);

  // Test 12: Exception propagation from nested routine
  println("=== Exception propagation ===");
  testPropagation();

  println("Done");
end.